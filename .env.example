# Database (Local PostgreSQL)
# For Docker Compose, the database service host is "db"
DATABASE_URL="postgresql://postgres:postgres@db:5432/papertrade?schema=public"

# Auth.js / NextAuth (Local JWT session)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-string-at-least-32-chars"
AUTH_SECRET="replace-with-a-secure-random-string-at-least-32-chars"

# App
NEXT_PUBLIC_APP_NAME="Paper Trade"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Business Details (Used on printed PDFs: Invoices, Purchase Orders, Delivery Orders, etc.)
BUSINESS_NAME="Paper Trade Co."
BUSINESS_ADDRESS="Shop floor & Main Warehouse"
BUSINESS_PHONE="+92 300 1234567"
BUSINESS_EMAIL="owner@example.com"
OWNER_EMAIL="owner@example.com"

# Initial Seed Business Owner Credentials
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="ChangeMe123!"
