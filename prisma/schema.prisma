generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum LocationType {
  SHOP
  WAREHOUSE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DELIVERY_OUT
  SALE_RETURN
  PURCHASE_RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  FULFILLED
  CANCELLED
}

enum DeliveryOrderStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  OPEN
  SETTLED
  CANCELLED
  DRAFT
  POSTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum AccountType {
  SALES
  PURCHASES
  CASH
  RECEIVABLE
  PAYABLE
  INVENTORY
  EXPENSE
  COGS
  DIRECT_COST
  EQUITY
}

enum LedgerAccountSubtype {
  PRODUCT_SALES
  FREIGHT_REVENUE
  TRADE_PAYABLE
  PARTNER_CAPITAL
  PARTNER_PROFIT
  PARTNER_EXPENSE_DUE
  OPEX
  CASH_DRAWER
  BANK
  JAZZCASH
  EASYPAISA
  OPENING_STOCK_EQUITY
}

enum PaymentMethod {
  CASH
  BANK
  CHEQUE
  JAZZCASH
  EASYPAISA
  OTHER
}

enum Unit {
  SHEET
  REAM
  PACKET
  KG
  TONNE
  ROLL
  BOX
  PCS
}

enum PartnershipType {
  CONSIGNMENT_VMI
  CO_INVESTED_POOL
}

enum LotStatus {
  ACTIVE
  EXHAUSTED
  SETTLED
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  permissions  Json?    @default("{}")
  createdAt    DateTime @default(now())

  stockMovements         StockMovement[]
  productPriceHistory    ProductPriceHistory[]
  purchaseOrders         PurchaseOrder[]
  purchaseInvoices       PurchaseInvoice[]
  deliveryOrders         DeliveryOrder[]
  saleInvoices           SaleInvoice[]
  saleReturns            SaleReturn[]
  purchaseReturns        PurchaseReturn[]
  ledgerEntries          LedgerEntry[]
  payments               Payment[]
  expenses               Expense[]
}

model FinancialYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleInvoices     SaleInvoice[]
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  deliveryOrders   DeliveryOrder[]
  saleReturns      SaleReturn[]
  purchaseReturns  PurchaseReturn[]
  payments         Payment[]
  sequences        DocumentSequence[]
  openingBalances  LedgerEntry[]      @relation("SourceFinancialYear")

  @@index([isActive])
  @@index([isClosed])
}

model DocumentSequence {
  id              String        @id @default(cuid())
  financialYearId String
  documentType    String
  lastSequence    Int           @default(0)

  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@unique([financialYearId, documentType])
}

model Location {
  id        String       @id @default(cuid())
  name      String
  type      LocationType
  address   String?
  isActive  Boolean      @default(true)
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  stockMovements          StockMovement[]
  purchaseOrders          PurchaseOrder[]
  purchaseInvoices        PurchaseInvoice[]
  purchaseInvoiceItems    PurchaseInvoiceItem[]
  deliveryOrders          DeliveryOrder[]          @relation("SourceLocation")
  deliveryOrdersIn        DeliveryOrder[]          @relation("DestinationLocation")
  saleInvoices            SaleInvoice[]
  saleInvoiceItems        SaleInvoiceItem[]
  saleReturns             SaleReturn[]
  purchaseReturns         PurchaseReturn[]
  warehouseStorageCharges WarehouseStorageCharge[]
  warehouseLots           WarehouseLot[]
  partnershipLots         PartnershipLot[]         @relation("WarehousePartnershipLots")
  deliveryOrderItems      DeliveryOrderItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  beneficiaryParties      Party[]                  @relation("PartnerWarehouseLocation")
  costLayers              InventoryCostLayer[]
  productCostStates       ProductCostState[]
  costMovements           CostMovement[]

  @@unique([name, type])
  @@index([type, isActive])
}

model WarehouseLot {
  id          String    @id @default(cuid())
  locationId  String
  partnerId   String?
  unitCost    Decimal?  @db.Decimal(14, 4)
  lotNumber   String
  description String?
  partnerSharePct Decimal? @default(100) @db.Decimal(5, 2)
  clientSharePct  Decimal? @default(0) @db.Decimal(5, 2)
  initialCapital  Decimal? @db.Decimal(14, 4)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  location             Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  partner              Party?                @relation("PartnerLots", fields: [partnerId], references: [id])
  stockMovements       StockMovement[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  deliveryOrderItems   DeliveryOrderItem[]
  destinationDeliveryOrders DeliveryOrder[] @relation("DoDestinationLot")
  saleInvoiceItems     SaleInvoiceItem[]
  costLayers           InventoryCostLayer[]

  @@unique([locationId, lotNumber])
  @@index([locationId, isActive])
  @@index([partnerId])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  isActive Boolean   @default(true)
  products Product[]
}

model Quality {
  id       String    @id @default(cuid())
  name     String    @unique
  isActive Boolean   @default(true)
  products Product[]
}

model Product {
  id             String    @id @default(cuid())
  productNo      String    @unique
  name           String
  categoryId     String
  qualityId      String
  unit           Unit      @default(PACKET)
  length         Decimal   @db.Decimal(12, 4)
  breadth        Decimal   @db.Decimal(12, 4)
  gsm            Decimal   @db.Decimal(12, 4)
  packetWeight   Decimal   @db.Decimal(14, 6)
  reamWeight     Decimal   @db.Decimal(14, 6)
  costPrice      Decimal   @db.Decimal(14, 4)
  retailPrice    Decimal   @db.Decimal(14, 4)
  wholesalePrice Decimal   @db.Decimal(14, 4)
  labourCharges  Decimal   @default(0) @db.Decimal(14, 4)
  reorderLevel   Decimal?  @db.Decimal(14, 4)
  serialNo       String?
  remarks        String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category              Category               @relation(fields: [categoryId], references: [id])
  quality               Quality                @relation(fields: [qualityId], references: [id])
  priceHistory          ProductPriceHistory[]
  stockMovements        StockMovement[]
  purchaseOrderItems    PurchaseOrderItem[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]
  deliveryOrderItems    DeliveryOrderItem[]
  saleInvoiceItems      SaleInvoiceItem[]
  saleReturnItems       SaleReturnItem[]
  purchaseReturnItems   PurchaseReturnItem[]
  partnershipLotItems   PartnershipLotItem[]
  partnershipSaleAllocations PartnershipSaleAllocation[]
  costLayers            InventoryCostLayer[]
  productCostStates     ProductCostState[]
  costMovements         CostMovement[]

  @@index([categoryId])
  @@index([qualityId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
  @@index([name])
}

model ProductPriceHistory {
  id             String   @id @default(cuid())
  productId      String
  costPrice      Decimal  @db.Decimal(14, 4)
  retailPrice    Decimal  @db.Decimal(14, 4)
  wholesalePrice Decimal  @db.Decimal(14, 4)
  effectiveFrom  DateTime @default(now())
  createdById    String
  createdAt      DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId, effectiveFrom])
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  locationId     String
  warehouseLotId   String?
  partnershipLotId String?
  ownershipType    String?
  ownershipKey     String?
  type             StockMovementType
  quantity         Decimal           @db.Decimal(14, 4)
  referenceType    String
  referenceId      String
  createdById      String
  createdAt        DateTime          @default(now())
  notes            String?

  product        Product         @relation(fields: [productId], references: [id])
  location       Location        @relation(fields: [locationId], references: [id])
  warehouseLot   WarehouseLot?   @relation(fields: [warehouseLotId], references: [id])
  partnershipLot PartnershipLot? @relation(fields: [partnershipLotId], references: [id])
  createdBy      User            @relation(fields: [createdById], references: [id])

  @@index([productId, locationId, type])
  @@index([productId, locationId, warehouseLotId, type])
  @@index([locationId])
  @@index([productId, warehouseLotId])
  @@index([warehouseLotId])
  @@index([partnershipLotId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@index([type])
}

model Party {
  id                 String    @id @default(cuid())
  name               String
  type               PartyType
  isCustomer         Boolean   @default(false)
  isSupplier         Boolean   @default(false)
  isPartner          Boolean   @default(false)
  isBeneficiary      Boolean   @default(false)
  partnerWarehouseId String?
  phone              String?
  email              String?
  address            String?
  creditLimit        Decimal?  @db.Decimal(14, 4)
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())

  partnerWarehouse  Location?         @relation("PartnerWarehouseLocation", fields: [partnerWarehouseId], references: [id])
  partnerLots       WarehouseLot[]    @relation("PartnerLots")
  partnershipLots   PartnershipLot[]  @relation("PartnerPartnershipLots")
  purchaseOrders    PurchaseOrder[]
  purchaseInvoices  PurchaseInvoice[]
  deliveryOrders    DeliveryOrder[]
  saleInvoices      SaleInvoice[]
  saleReturns       SaleReturn[]
  purchaseReturns   PurchaseReturn[]
  ledgerEntries     LedgerEntry[]
  payments          Payment[]

  @@index([type, isActive])
  @@index([isBeneficiary])
  @@index([isPartner])
  @@index([name])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  orderNo         String               @unique
  financialYearId String?
  sequenceNo      Int?
  supplierId      String
  locationId      String
  date            DateTime
  status          PurchaseOrderStatus  @default(DRAFT)
  includePricing  Boolean              @default(true)
  isPartnership   Boolean              @default(false)
  partnershipId   String?
  notes           String?
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  financialYear FinancialYear?      @relation(fields: [financialYearId], references: [id])
  supplier      Party               @relation(fields: [supplierId], references: [id])
  location      Location            @relation(fields: [locationId], references: [id])
  createdBy     User                @relation(fields: [createdById], references: [id])
  items         PurchaseOrderItem[]
  invoices      PurchaseInvoice[]

  @@index([financialYearId])
  @@index([supplierId])
  @@index([locationId])
  @@index([date])
  @@index([status])
  @@index([partnershipId])
  @@index([isPartnership])
}

model PurchaseOrderItem {
  id                    String        @id @default(cuid())
  orderId               String
  productId             String
  destinationLocationId String?
  warehouseLotId        String?
  quantity              Decimal       @db.Decimal(14, 4)
  unitCost              Decimal?      @db.Decimal(14, 4)
  lineTotal             Decimal?      @db.Decimal(14, 4)

  order               PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id])
  destinationLocation Location?     @relation(fields: [destinationLocationId], references: [id])
  warehouseLot        WarehouseLot? @relation(fields: [warehouseLotId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([destinationLocationId])
  @@index([warehouseLotId])
}

model PurchaseInvoice {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique
  financialYearId String?
  sequenceNo      Int?
  supplierId      String
  locationId      String
  purchaseOrderId String?
  date            DateTime
  status          InvoiceStatus @default(OPEN)
  isPartnership   Boolean       @default(false)
  partnershipId   String?
  partnerSharePct Decimal?      @db.Decimal(5, 2)
  clientSharePct  Decimal?      @db.Decimal(5, 2)
  totalAmount     Decimal       @db.Decimal(14, 4)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 4)
  paidAmount      Decimal       @default(0) @db.Decimal(14, 4)
  balanceAmount   Decimal       @default(0) @db.Decimal(14, 4)
  paymentStatus   PaymentStatus @default(UNPAID)
  freightCharges  Decimal       @default(0) @db.Decimal(14, 4)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  financialYear FinancialYear?        @relation(fields: [financialYearId], references: [id])
  supplier      Party                 @relation(fields: [supplierId], references: [id])
  location      Location              @relation(fields: [locationId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])
  items         PurchaseInvoiceItem[]
  returns       PurchaseReturn[]
  payments      Payment[]
  allocations   InvoicePaymentAllocation[]

  @@index([financialYearId])
  @@index([supplierId])
  @@index([locationId])
  @@index([date])
  @@index([status])
  @@index([partnershipId])
  @@index([isPartnership])
}

model PurchaseInvoiceItem {
  id             String        @id @default(cuid())
  invoiceId      String
  productId      String
  locationId     String?
  warehouseLotId String?
  quantity       Decimal       @db.Decimal(14, 4)
  unitCost       Decimal       @db.Decimal(14, 4)
  landedUnitCost Decimal?      @db.Decimal(14, 4)
  lineTotal      Decimal       @db.Decimal(14, 4)

  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id])
  location     Location?       @relation(fields: [locationId], references: [id])
  warehouseLot WarehouseLot?   @relation(fields: [warehouseLotId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([locationId])
  @@index([warehouseLotId])
}

model DeliveryOrder {
  id                    String               @id @default(cuid())
  doNo                  String               @unique
  financialYearId       String?
  sequenceNo            Int?
  customerId            String?
  locationId            String
  destinationLocationId String?
  destinationWarehouseLotId String?
  saleInvoiceId         String?              @unique
  date                  DateTime
  status                DeliveryOrderStatus  @default(DRAFT)
  vehicleNo             String?
  driverName            String?
  deliveredTo           String?
  recipientName         String?
  notes                 String?
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  financialYear       FinancialYear?      @relation(fields: [financialYearId], references: [id])
  customer            Party?              @relation(fields: [customerId], references: [id])
  location            Location            @relation("SourceLocation", fields: [locationId], references: [id])
  destinationLocation Location?           @relation("DestinationLocation", fields: [destinationLocationId], references: [id])
  destinationWarehouseLot WarehouseLot?    @relation("DoDestinationLot", fields: [destinationWarehouseLotId], references: [id])
  linkedSaleInvoice   SaleInvoice?        @relation("DeliveryOrderToSaleInvoice", fields: [saleInvoiceId], references: [id])
  saleInvoiceFromDo   SaleInvoice?        @relation("SaleInvoiceToDeliveryOrder")
  createdBy           User                @relation(fields: [createdById], references: [id])
  items               DeliveryOrderItem[]

  @@index([financialYearId])
  @@index([customerId])
  @@index([locationId])
  @@index([destinationLocationId])
  @@index([date])
  @@index([status])
}

model DeliveryOrderItem {
  id             String        @id @default(cuid())
  doId           String
  productId      String
  locationId     String?
  destinationLocationId String?
  warehouseLotId String?
  lotId          String?
  partnershipLotId String?
  ownershipType  String?
  ownershipKey   String?
  quantity       Decimal       @db.Decimal(14, 4)
  unit           Unit

  deliveryOrder  DeliveryOrder   @relation(fields: [doId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  location       Location?       @relation(fields: [locationId], references: [id])
  warehouseLot   WarehouseLot?   @relation(fields: [warehouseLotId], references: [id])
  lot            PartnershipLot? @relation(fields: [lotId], references: [id])

  @@index([doId])
  @@index([productId])
  @@index([locationId])
  @@index([warehouseLotId])
  @@index([lotId])
}

model SaleInvoice {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique
  financialYearId String?
  sequenceNo      Int?
  customerId      String
  locationId      String
  deliveryOrderId String?       @unique
  date            DateTime
  status          InvoiceStatus @default(OPEN)
  isPartnership   Boolean       @default(false)
  partnershipId   String?
  totalAmount     Decimal       @db.Decimal(14, 4)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 4)
  paidAmount      Decimal       @default(0) @db.Decimal(14, 4)
  balanceAmount   Decimal       @default(0) @db.Decimal(14, 4)
  paymentStatus   PaymentStatus @default(UNPAID)
  freightCharges  Decimal       @default(0) @db.Decimal(14, 4)
  actualFreightCost Decimal?    @db.Decimal(14, 4)
  walkInName      String?
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  financialYear       FinancialYear? @relation(fields: [financialYearId], references: [id])
  customer            Party          @relation(fields: [customerId], references: [id])
  location            Location       @relation(fields: [locationId], references: [id])
  deliveryOrder       DeliveryOrder? @relation("SaleInvoiceToDeliveryOrder", fields: [deliveryOrderId], references: [id])
  deliveryFromInvoice DeliveryOrder? @relation("DeliveryOrderToSaleInvoice")
  createdBy           User           @relation(fields: [createdById], references: [id])
  items               SaleInvoiceItem[]
  returns             SaleReturn[]
  payments            Payment[]                   @relation("SaleInvoicePayments")
  allocations         InvoicePaymentAllocation[]
  partnershipSaleAllocations PartnershipSaleAllocation[]

  @@index([financialYearId])
  @@index([customerId])
  @@index([locationId])
  @@index([date])
  @@index([status])
  @@index([partnershipId])
  @@index([isPartnership])
}

model SaleInvoiceItem {
  id             String        @id @default(cuid())
  invoiceId      String
  productId      String
  locationId     String?
  warehouseLotId String?
  lotId          String?
  quantity       Decimal       @db.Decimal(14, 4)
  unitPrice      Decimal       @db.Decimal(14, 4)
  unitCost       Decimal?      @db.Decimal(14, 4)
  lineTotal      Decimal       @db.Decimal(14, 4)
  cogsAmount     Decimal?      @db.Decimal(14, 4)
  ownershipType  String?
  ownershipKey   String?

  invoice      SaleInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id])
  location     Location?       @relation(fields: [locationId], references: [id])
  warehouseLot WarehouseLot?   @relation(fields: [warehouseLotId], references: [id])
  lot          PartnershipLot? @relation(fields: [lotId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([locationId])
  @@index([warehouseLotId])
  @@index([lotId])
}

model SaleReturn {
  id              String   @id @default(cuid())
  returnNo        String   @unique
  financialYearId String?
  sequenceNo      Int?
  saleInvoiceId   String
  customerId      String
  locationId      String
  date            DateTime
  reason          String
  totalAmount     Decimal  @db.Decimal(14, 4)
  createdById     String
  createdAt       DateTime @default(now())

  financialYear FinancialYear?   @relation(fields: [financialYearId], references: [id])
  saleInvoice   SaleInvoice      @relation(fields: [saleInvoiceId], references: [id])
  customer      Party            @relation(fields: [customerId], references: [id])
  location      Location         @relation(fields: [locationId], references: [id])
  createdBy     User             @relation(fields: [createdById], references: [id])
  items         SaleReturnItem[]

  @@index([financialYearId])
  @@index([saleInvoiceId])
  @@index([customerId])
  @@index([date])
}

model SaleReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(14, 4)
  lineTotal Decimal @db.Decimal(14, 4)
  costRestoredAmount Decimal @default(0) @db.Decimal(14, 4)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

model PurchaseReturn {
  id                String   @id @default(cuid())
  returnNo          String   @unique
  financialYearId   String?
  sequenceNo        Int?
  purchaseInvoiceId String
  supplierId        String
  locationId        String
  date              DateTime
  reason            String
  totalAmount       Decimal  @db.Decimal(14, 4)
  createdById       String
  createdAt         DateTime @default(now())

  financialYear   FinancialYear?       @relation(fields: [financialYearId], references: [id])
  purchaseInvoice PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id])
  supplier        Party                @relation(fields: [supplierId], references: [id])
  location        Location             @relation(fields: [locationId], references: [id])
  createdBy       User                 @relation(fields: [createdById], references: [id])
  items           PurchaseReturnItem[]

  @@index([financialYearId])
  @@index([purchaseInvoiceId])
  @@index([supplierId])
  @@index([date])
}

model PurchaseReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unitCost  Decimal @db.Decimal(14, 4)
  lineTotal Decimal @db.Decimal(14, 4)

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

model LedgerEntry {
  id                    String         @id @default(cuid())
  partyId               String?
  sourceFinancialYearId String?
  accountType           AccountType
  accountSubtype        LedgerAccountSubtype?
  lineType              String?
  lineNo                Int?
  idempotencyKey        String?        @unique
  ownershipType         String?
  ownershipKey          String?
  debit                 Decimal        @default(0) @db.Decimal(14, 4)
  credit                Decimal        @default(0) @db.Decimal(14, 4)
  isPartnership         Boolean        @default(false)
  partnershipId         String?
  referenceType         String
  referenceId           String
  date                  DateTime
  description           String
  createdById           String
  createdAt             DateTime       @default(now())

  party               Party?         @relation(fields: [partyId], references: [id])
  sourceFinancialYear FinancialYear? @relation("SourceFinancialYear", fields: [sourceFinancialYearId], references: [id])
  createdBy           User           @relation(fields: [createdById], references: [id])

  @@index([sourceFinancialYearId])
  @@index([partyId, date])
  @@index([partyId])
  @@index([accountType, date])
  @@index([accountType])
  @@index([referenceType, referenceId])
  @@index([date])
  @@index([partnershipId])
  @@index([isPartnership])
  @@index([partyId, isPartnership])
}

model Payment {
  id                String        @id @default(cuid())
  receiptNo         String?       @unique
  financialYearId   String?
  sequenceNo        Int?
  partyId           String
  saleInvoiceId     String?
  purchaseInvoiceId String?
  amount            Decimal       @db.Decimal(14, 4)
  method            PaymentMethod
  direction         String        @default("IN")
  isPartnership     Boolean       @default(false)
  partnershipId     String?
  remainingBalance  Decimal?      @db.Decimal(14, 4)
  date              DateTime
  notes             String?
  createdById       String
  createdAt         DateTime      @default(now())

  financialYear   FinancialYear?             @relation(fields: [financialYearId], references: [id])
  party           Party                      @relation(fields: [partyId], references: [id])
  saleInvoice     SaleInvoice?               @relation("SaleInvoicePayments", fields: [saleInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice?           @relation(fields: [purchaseInvoiceId], references: [id])
  createdBy       User                       @relation(fields: [createdById], references: [id])
  splits          PaymentSplit[]
  allocations     InvoicePaymentAllocation[]

  @@index([financialYearId])
  @@index([partyId])
  @@index([date])
  @@index([saleInvoiceId])
  @@index([purchaseInvoiceId])
  @@index([direction])
  @@index([partnershipId])
  @@index([isPartnership])
}

model InvoicePaymentAllocation {
  id                String           @id @default(cuid())
  paymentId         String
  saleInvoiceId     String?
  purchaseInvoiceId String?
  amount            Decimal          @db.Decimal(14, 4)
  createdAt         DateTime         @default(now())

  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  saleInvoice     SaleInvoice?     @relation(fields: [saleInvoiceId], references: [id], onDelete: Cascade)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([saleInvoiceId])
  @@index([purchaseInvoiceId])
}

model PaymentSplit {
  id        String        @id @default(cuid())
  paymentId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 4)
  reference String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model WarehouseStorageCharge {
  id           String   @id @default(cuid())
  locationId   String
  weightInTonnes Decimal @db.Decimal(14, 4)
  ratePerTonne Decimal  @db.Decimal(14, 4)
  periodStart  DateTime
  periodEnd    DateTime
  totalCharge  Decimal  @db.Decimal(14, 4)
  createdAt    DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, periodStart])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

enum ExpenseCategory {
  OFFICE_SUPPLIES
  UTILITIES
  RENT
  SALARIES
  TRANSPORT_FUEL
  MAINTENANCE
  TEA_REFRESHMENTS
  TAXES_FEES
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  expenseNo   String          @unique
  saleInvoiceId String?
  partnershipLotId String?
  category    ExpenseCategory @default(OTHER)
  categoryLabel String?
  isOperatingExpense Boolean    @default(true)
  amount      Decimal         @db.Decimal(14, 4)
  method      PaymentMethod   @default(CASH)
  date        DateTime
  description String
  notes       String?
  createdById String
  createdAt   DateTime        @default(now())

  createdBy   User            @relation(fields: [createdById], references: [id])
  partnershipLot PartnershipLot? @relation(fields: [partnershipLotId], references: [id])

  @@index([date])
  @@index([category])
  @@index([createdById])
  @@index([partnershipLotId])
}

model PartnershipLot {
  id                    String              @id @default(cuid())
  lotNumber             String              @unique // e.g., "LOT-2026-001"
  partnerId             String
  partner               Party               @relation("PartnerPartnershipLots", fields: [partnerId], references: [id])
  type                  PartnershipType     @default(CO_INVESTED_POOL)
  /// CONSIGNMENT | CO_INVESTED — mirrors type for reporting; CONSIGNMENT_VMI → CONSIGNMENT, CO_INVESTED_POOL → CO_INVESTED
  archetype             String?
  status                LotStatus           @default(ACTIVE)

  totalCapitalCost      Decimal             @db.Decimal(14, 2)
  entityCapitalShare    Decimal             @db.Decimal(14, 2)
  partnerCapitalShare   Decimal             @db.Decimal(14, 2)
  partnerMarginRatio    Decimal             @db.Decimal(5, 4) // e.g., 0.5000 for 50%

  warehouseId           String
  warehouse             Location            @relation("WarehousePartnershipLots", fields: [warehouseId], references: [id])
  warehouseLotId        String?             @unique

  items                 PartnershipLotItem[]
  expenses              PartnershipExpense[]
  allocations           PartnershipSaleAllocation[]
  reconciliations       PartnershipReconciliation[]
  saleInvoiceItems      SaleInvoiceItem[]
  deliveryOrderItems    DeliveryOrderItem[]
  stockMovements        StockMovement[]
  expensesLedger        Expense[]
  productCostStates     ProductCostState[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([partnerId])
  @@index([warehouseId])
  @@index([status])
  @@index([archetype])
}

model PartnershipLotItem {
  id                    String              @id @default(cuid())
  lotId                 String
  lot                   PartnershipLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  productId             String
  product               Product             @relation(fields: [productId], references: [id])
  initialQuantity       Decimal             @db.Decimal(12, 2)
  remainingQuantity     Decimal             @db.Decimal(12, 2)
  unitCostRate          Decimal             @db.Decimal(12, 2)

  @@index([lotId])
  @@index([productId])
}

model PartnershipExpense {
  id                    String              @id @default(cuid())
  lotId                 String
  lot                   PartnershipLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  category              String              // "Carrying Cost", "Warehouse Rent", "Handling & Labor", "Freight Inward"
  description           String
  amount                Decimal             @db.Decimal(12, 2)
  paidBy                String              // "ENTITY" | "PARTNER"
  entityShare           Decimal?            @db.Decimal(12, 2)
  partnerShare          Decimal?            @db.Decimal(12, 2)
  createdAt             DateTime            @default(now())

  @@index([lotId])
}

enum PartnershipSettlementKind {
  CAPITAL
  PROFIT
  EXPENSE_REIMBURSEMENT
}

model PartnershipSettlementAllocation {
  id          String                    @id @default(cuid())
  paymentId   String
  lotId       String
  kind        PartnershipSettlementKind
  amount      Decimal                   @db.Decimal(14, 4)
  createdAt   DateTime                  @default(now())

  @@index([paymentId])
  @@index([lotId])
}

model PartnershipSaleAllocation {
  id                    String              @id @default(cuid())
  lotId                 String
  lot                   PartnershipLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  invoiceId             String?
  invoice               SaleInvoice?        @relation(fields: [invoiceId], references: [id])
  productId             String
  product               Product             @relation(fields: [productId], references: [id])
  quantity              Decimal             @db.Decimal(12, 2)
  unitCostRate          Decimal             @db.Decimal(12, 2)
  unitSaleRate          Decimal             @db.Decimal(12, 2)
  grossMargin           Decimal             @db.Decimal(12, 2)
  partnerMarginShare    Decimal             @db.Decimal(12, 2)
  salesChannel          String              // "INTERNAL_POS" | "EXTERNAL_PARTNER"
  soldBy                String              @default("OWNER") // "OWNER" | "PARTNER"
  allocatedAt           DateTime            @default(now())

  @@index([lotId])
  @@index([soldBy])
  @@index([invoiceId])
  @@index([productId])
}

model PartnershipReconciliation {
  id                    String              @id @default(cuid())
  lotId                 String
  lot                   PartnershipLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  periodStart           DateTime
  periodEnd             DateTime
  totalUnitsSold        Decimal             @db.Decimal(12, 2)
  netGrossMargin        Decimal             @db.Decimal(12, 2)
  totalAccruedPayable   Decimal             @db.Decimal(12, 2)
  distributedCapital    Decimal             @default(0) @db.Decimal(12, 2)
  reconciledAt          DateTime?

  @@index([lotId])
}

/// @deprecated Use ProductCostState + CostMovement (WAC). Do not write new rows after Phase 4.
model InventoryCostLayer {
  id              String        @id @default(cuid())
  productId       String
  locationId      String
  warehouseLotId  String?
  partnershipLotId String?
  sourceType      String        // "OPENING_STOCK" | "PURCHASE" | "TRANSFER" | "ADJUSTMENT"
  sourceId        String        // Invoice ID or Movement ID or Ref Number
  unitCost        Decimal       @db.Decimal(14, 4)
  initialQty      Decimal       @db.Decimal(14, 4)
  remainingQty    Decimal       @db.Decimal(14, 4)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  product         Product       @relation(fields: [productId], references: [id])
  location        Location      @relation(fields: [locationId], references: [id])
  warehouseLot    WarehouseLot? @relation(fields: [warehouseLotId], references: [id])
  consumptions    InventoryCostLayerConsumption[]

  @@index([productId, locationId, remainingQty])
  @@index([createdAt])
  @@index([sourceType, sourceId])
  @@index([partnershipLotId])
}

/// @deprecated See InventoryCostLayer — FIFO consumption audit; no new writes after Phase 4.
model InventoryCostLayerConsumption {
  id             String   @id @default(cuid())
  layerId        String
  productId      String
  locationId     String
  warehouseLotId String?
  quantity       Decimal  @db.Decimal(14, 4)
  unitCost       Decimal  @db.Decimal(14, 4)
  referenceType  String
  referenceId    String
  createdAt      DateTime @default(now())

  layer InventoryCostLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@index([referenceType, referenceId])
  @@index([layerId])
}

model ProductCostState {
  id               String   @id @default(cuid())
  productId        String
  locationId       String
  ownershipType    String
  partnershipLotId String?
  ownershipKey     String
  quantity         Decimal  @db.Decimal(14, 4)
  avgCost          Decimal  @db.Decimal(14, 4)
  totalValue       Decimal  @db.Decimal(14, 4)
  hasNegativeStock Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id])
  location       Location        @relation(fields: [locationId], references: [id])
  partnershipLot PartnershipLot? @relation(fields: [partnershipLotId], references: [id])

  @@unique([productId, locationId, ownershipKey])
  @@index([partnershipLotId])
  @@index([ownershipKey])
}

model CostMovement {
  id            String   @id @default(cuid())
  productId     String
  locationId    String
  ownershipKey  String
  movementType  String
  referenceType String
  referenceId   String
  qtyBefore     Decimal  @db.Decimal(14, 4)
  avgBefore     Decimal  @db.Decimal(14, 4)
  qtyDelta      Decimal  @db.Decimal(14, 4)
  unitCost      Decimal  @db.Decimal(14, 4)
  totalCost     Decimal  @db.Decimal(14, 4)
  qtyAfter      Decimal  @db.Decimal(14, 4)
  avgAfter      Decimal  @db.Decimal(14, 4)
  createdAt     DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([productId, locationId, ownershipKey, createdAt])
  @@index([referenceType, referenceId])
}

