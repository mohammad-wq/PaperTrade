generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum LocationType {
  SHOP
  WAREHOUSE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DELIVERY_OUT
  SALE_RETURN
  PURCHASE_RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  FULFILLED
  CANCELLED
}

enum DeliveryOrderStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AccountType {
  SALES
  PURCHASES
  CASH
  RECEIVABLE
  PAYABLE
  INVENTORY
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK
  CHEQUE
  OTHER
}

enum Unit {
  SHEET
  REAM
  PACKET
  KG
  TONNE
  ROLL
  BOX
  PCS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  stockMovements         StockMovement[]
  productPriceHistory    ProductPriceHistory[]
  purchaseOrders         PurchaseOrder[]
  purchaseInvoices       PurchaseInvoice[]
  deliveryOrders         DeliveryOrder[]
  saleInvoices           SaleInvoice[]
  saleReturns            SaleReturn[]
  purchaseReturns        PurchaseReturn[]
  ledgerEntries          LedgerEntry[]
  payments               Payment[]
}

model Location {
  id      String       @id @default(cuid())
  name    String
  type    LocationType
  address String?

  stockMovements          StockMovement[]
  purchaseOrders          PurchaseOrder[]
  purchaseInvoices        PurchaseInvoice[]
  deliveryOrders          DeliveryOrder[]
  saleInvoices            SaleInvoice[]
  saleReturns             SaleReturn[]
  purchaseReturns         PurchaseReturn[]
  warehouseStorageCharges WarehouseStorageCharge[]

  @@unique([name, type])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  isActive Boolean   @default(true)
  products Product[]
}

model Quality {
  id       String    @id @default(cuid())
  name     String    @unique
  isActive Boolean   @default(true)
  products Product[]
}

model Product {
  id             String    @id @default(cuid())
  productNo      String    @unique
  name           String
  categoryId     String
  qualityId      String
  unit           Unit      @default(PACKET)
  length         Decimal   @db.Decimal(12, 4)
  breadth        Decimal   @db.Decimal(12, 4)
  gsm            Decimal   @db.Decimal(12, 4)
  packetWeight   Decimal   @db.Decimal(14, 6)
  reamWeight     Decimal   @db.Decimal(14, 6)
  costPrice      Decimal   @db.Decimal(14, 4)
  retailPrice    Decimal   @db.Decimal(14, 4)
  wholesalePrice Decimal   @db.Decimal(14, 4)
  labourCharges  Decimal   @default(0) @db.Decimal(14, 4)
  reorderLevel   Decimal?  @db.Decimal(14, 4)
  serialNo       String?
  remarks        String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category              Category               @relation(fields: [categoryId], references: [id])
  quality               Quality                @relation(fields: [qualityId], references: [id])
  priceHistory          ProductPriceHistory[]
  stockMovements        StockMovement[]
  purchaseOrderItems    PurchaseOrderItem[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]
  deliveryOrderItems    DeliveryOrderItem[]
  saleInvoiceItems      SaleInvoiceItem[]
  saleReturnItems       SaleReturnItem[]
  purchaseReturnItems   PurchaseReturnItem[]

  @@index([categoryId])
  @@index([qualityId])
  @@index([isActive])
  @@index([name])
}

model ProductPriceHistory {
  id             String   @id @default(cuid())
  productId      String
  costPrice      Decimal  @db.Decimal(14, 4)
  retailPrice    Decimal  @db.Decimal(14, 4)
  wholesalePrice Decimal  @db.Decimal(14, 4)
  effectiveFrom  DateTime @default(now())
  createdById    String
  createdAt      DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId, effectiveFrom])
}

model StockMovement {
  id            String             @id @default(cuid())
  productId     String
  locationId    String
  type          StockMovementType
  quantity      Decimal            @db.Decimal(14, 4)
  referenceType String
  referenceId   String
  createdById   String
  createdAt     DateTime           @default(now())
  notes         String?

  product   Product  @relation(fields: [productId], references: [id])
  location  Location @relation(fields: [locationId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([productId, locationId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@index([type])
}

model Party {
  id          String    @id @default(cuid())
  name        String
  type        PartyType
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal?  @db.Decimal(14, 4)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  purchaseOrders    PurchaseOrder[]
  purchaseInvoices  PurchaseInvoice[]
  deliveryOrders    DeliveryOrder[]
  saleInvoices      SaleInvoice[]
  saleReturns       SaleReturn[]
  purchaseReturns   PurchaseReturn[]
  ledgerEntries     LedgerEntry[]
  payments          Payment[]

  @@unique([email, type])
  @@index([type, isActive])
  @@index([name])
}

model PurchaseOrder {
  id         String               @id @default(cuid())
  orderNo    String               @unique
  supplierId String
  locationId String
  date       DateTime
  status     PurchaseOrderStatus  @default(DRAFT)
  notes      String?
  createdById String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  supplier  Party               @relation(fields: [supplierId], references: [id])
  location  Location            @relation(fields: [locationId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
  invoices  PurchaseInvoice[]

  @@index([supplierId])
  @@index([locationId])
  @@index([date])
  @@index([status])
}

model PurchaseOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unitCost  Decimal @db.Decimal(14, 4)
  lineTotal Decimal @db.Decimal(14, 4)

  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model PurchaseInvoice {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique
  supplierId      String
  locationId      String
  purchaseOrderId String?
  date            DateTime
  status          InvoiceStatus @default(POSTED)
  totalAmount     Decimal       @db.Decimal(14, 4)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  supplier      Party                 @relation(fields: [supplierId], references: [id])
  location      Location              @relation(fields: [locationId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])
  items         PurchaseInvoiceItem[]
  returns       PurchaseReturn[]
  payments      Payment[]

  @@index([supplierId])
  @@index([locationId])
  @@index([date])
  @@index([status])
}

model PurchaseInvoiceItem {
  id         String  @id @default(cuid())
  invoiceId  String
  productId  String
  quantity   Decimal @db.Decimal(14, 4)
  unitCost   Decimal @db.Decimal(14, 4)
  lineTotal  Decimal @db.Decimal(14, 4)

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model DeliveryOrder {
  id            String               @id @default(cuid())
  doNo          String               @unique
  customerId    String
  locationId    String
  saleInvoiceId String?              @unique
  date          DateTime
  status        DeliveryOrderStatus  @default(DRAFT)
  vehicleNo     String?
  driverName    String?
  deliveredTo   String?
  notes         String?
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  customer           Party               @relation(fields: [customerId], references: [id])
  location           Location            @relation(fields: [locationId], references: [id])
  linkedSaleInvoice  SaleInvoice?        @relation("DeliveryOrderToSaleInvoice", fields: [saleInvoiceId], references: [id])
  saleInvoiceFromDo  SaleInvoice?        @relation("SaleInvoiceToDeliveryOrder")
  createdBy          User                @relation(fields: [createdById], references: [id])
  items              DeliveryOrderItem[]

  @@index([customerId])
  @@index([locationId])
  @@index([date])
  @@index([status])
}

model DeliveryOrderItem {
  id        String  @id @default(cuid())
  doId      String
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unit      Unit

  deliveryOrder DeliveryOrder @relation(fields: [doId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([doId])
  @@index([productId])
}

model SaleInvoice {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique
  customerId      String
  locationId      String
  deliveryOrderId String?       @unique
  date            DateTime
  status          InvoiceStatus @default(POSTED)
  totalAmount     Decimal       @db.Decimal(14, 4)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 4)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer      Party             @relation(fields: [customerId], references: [id])
  location      Location          @relation(fields: [locationId], references: [id])
  deliveryOrder DeliveryOrder?    @relation("SaleInvoiceToDeliveryOrder", fields: [deliveryOrderId], references: [id])
  deliveryFromInvoice DeliveryOrder? @relation("DeliveryOrderToSaleInvoice")
  createdBy     User              @relation(fields: [createdById], references: [id])
  items         SaleInvoiceItem[]
  returns       SaleReturn[]
  payments      Payment[]         @relation("SaleInvoicePayments")

  @@index([customerId])
  @@index([locationId])
  @@index([date])
  @@index([status])
}

model SaleInvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(14, 4)
  lineTotal Decimal @db.Decimal(14, 4)

  invoice SaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product Product     @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model SaleReturn {
  id            String   @id @default(cuid())
  returnNo      String   @unique
  saleInvoiceId String
  customerId    String
  locationId    String
  date          DateTime
  reason        String
  totalAmount   Decimal  @db.Decimal(14, 4)
  createdById   String
  createdAt     DateTime @default(now())

  saleInvoice SaleInvoice      @relation(fields: [saleInvoiceId], references: [id])
  customer    Party            @relation(fields: [customerId], references: [id])
  location    Location         @relation(fields: [locationId], references: [id])
  createdBy   User             @relation(fields: [createdById], references: [id])
  items       SaleReturnItem[]

  @@index([saleInvoiceId])
  @@index([customerId])
  @@index([date])
}

model SaleReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(14, 4)
  lineTotal Decimal @db.Decimal(14, 4)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

model PurchaseReturn {
  id                String   @id @default(cuid())
  returnNo          String   @unique
  purchaseInvoiceId String
  supplierId        String
  locationId        String
  date              DateTime
  reason            String
  totalAmount       Decimal  @db.Decimal(14, 4)
  createdById       String
  createdAt         DateTime @default(now())

  purchaseInvoice PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id])
  supplier        Party                @relation(fields: [supplierId], references: [id])
  location        Location             @relation(fields: [locationId], references: [id])
  createdBy       User                 @relation(fields: [createdById], references: [id])
  items           PurchaseReturnItem[]

  @@index([purchaseInvoiceId])
  @@index([supplierId])
  @@index([date])
}

model PurchaseReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unitCost  Decimal @db.Decimal(14, 4)
  lineTotal Decimal @db.Decimal(14, 4)

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

model LedgerEntry {
  id            String      @id @default(cuid())
  partyId       String?
  accountType   AccountType
  debit         Decimal     @default(0) @db.Decimal(14, 4)
  credit        Decimal     @default(0) @db.Decimal(14, 4)
  referenceType String
  referenceId   String
  date          DateTime
  description   String
  createdById   String
  createdAt     DateTime    @default(now())

  party     Party? @relation(fields: [partyId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([partyId, date])
  @@index([accountType, date])
  @@index([referenceType, referenceId])
  @@index([date])
}

model Payment {
  id                String        @id @default(cuid())
  partyId           String
  saleInvoiceId     String?
  purchaseInvoiceId String?
  amount            Decimal       @db.Decimal(14, 4)
  method            PaymentMethod
  date              DateTime
  notes             String?
  createdById       String
  createdAt         DateTime      @default(now())

  party           Party            @relation(fields: [partyId], references: [id])
  saleInvoice     SaleInvoice?     @relation("SaleInvoicePayments", fields: [saleInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])

  @@index([partyId])
  @@index([date])
  @@index([saleInvoiceId])
  @@index([purchaseInvoiceId])
}

model WarehouseStorageCharge {
  id           String   @id @default(cuid())
  locationId   String
  weightInTonnes Decimal @db.Decimal(14, 4)
  ratePerTonne Decimal  @db.Decimal(14, 4)
  periodStart  DateTime
  periodEnd    DateTime
  totalCharge  Decimal  @db.Decimal(14, 4)
  createdAt    DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, periodStart])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
