# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Windows batch scripts MUST always use CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts MUST always use LF line endings
*.sh text eol=lf

# Explicitly ensure Unix-style line endings for source code and config
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.prisma text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
